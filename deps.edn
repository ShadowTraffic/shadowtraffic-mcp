{:paths   ["src" "resources"]
 :deps    {org.clojure/clojure             {:mvn/version "1.12.7"}
           io.modelcontextprotocol.sdk/mcp {:mvn/version "2.2.0"}
           org.slf4j/slf4j-simple          {:mvn/version "2.0.20"}}
 :aliases {:build {:extra-paths ["build"]
                   :deps        {io.github.clojure/tools.build {:git/tag "v0.10.14" :git/sha "1176afd"}}
                   :ns-default  build}
           :test  {:extra-paths ["test"]
                   :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                   :main-opts   ["-m" "cognitect.test-runner"]
                   :exec-fn     cognitect.test-runner.api/test}}}
